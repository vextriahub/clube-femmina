{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.{html,css,js}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/style\\.css",
      "dest": "/style.css"
    },
    {
      "src": "/script\\.js",
      "dest": "/script.js"
    },
    {
      "src": "/config\\.js",
      "dest": "/config.js"
    },
    {
      "src": "/api\\.js",
      "dest": "/api.js"
    },
    {
      "src": "/core\\.js",
      "dest": "/core.js"
    },
    {
      "src": "/auth\\.js",
      "dest": "/auth.js"
    },
    {
      "src": "/ui\\.js",
      "dest": "/ui.js"
    },
    {
      "src": "/pages-admin\\.js",
      "dest": "/pages-admin.js"
    },
    {
      "src": "/pages-member\\.js",
      "dest": "/pages-member.js"
    },
    {
      "src": "/app\\.js",
      "dest": "/app.js"
    },
    {
      "src": "/health",
      "dest": "/server.js"
    },
    {
      "src": "/debug/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/user/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/users(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/dependents(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/appointments(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
