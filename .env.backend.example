# ============================================
# Backend - Configuração Node.js Express
# ============================================

# API Port
PORT=3001

# Environment
NODE_ENV=development

# JWT Configuration
JWT_SECRET=sua-chave-secreta-muito-longa-e-segura-geracao-deve-ser-complexa-aqui-123456789
JWT_EXPIRES=7d

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=chave_anonima_supabase_aqui

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5000,http://localhost:3000

# Asaas (Pagamentos)
ASAAS_API_KEY=sua_chave_asaas_aqui
ASAAS_WEBHOOK_SECRET=seu_secret_webhook_aqui
