# ============================================
# CONFIGURAÇÕES DE AMBIENTE - .env
# ============================================
# Copie este arquivo para .env.local e preencha com suas credenciais reais
# IMPORTANTE: Nunca commitar arquivo .env com credenciais reais no Git!

# ============ SUPABASE ==============
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============ API BACKEND ===========
API_URL=http://localhost:3001
# Em produção: https://sua-api.vercel.app ou seu domínio

# ============ ASAAS PAYMENT ==========
ASAAS_API_KEY=$aact_YTU5YTE0M2Y2ZDEzNGJkNDk2MzI4YTdhMzk1YzM2ZjEx
ASAAS_WEBHOOK_SECRET=seu_webhook_secret_aqui

# ============ AMBIENTE ===============
NODE_ENV=development
# Opções: development, staging, production

# ============ FEATURES ===============
DEMO_ENABLED=true
# Em produção, defina como false para desabilitar credenciais de demonstração

ENABLE_PAYMENT=true
# Ativa integração com Asaas para pagamentos

ENABLE_SMS=false
# Ativa envio de SMS de lembrança de consultas

ENABLE_ANALYTICS=false
# Ativa coleta de dados analíticos
